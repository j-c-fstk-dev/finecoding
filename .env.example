# Copy this file to .env.local for local development, and set the same
# variables in Netlify (Site configuration -> Environment variables).

# --- Firebase (browser SDK, used only for the admin login) ---
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only, REQUIRED: all reads/writes go through it) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Copy "client_email" and "private_key" from the downloaded JSON.
# Never commit these values.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the two variables above: the whole JSON (plain or base64).
# FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Who can use the dashboard (server only, REQUIRED) ---
# Comma-separated. The Firebase Auth email(s) and/or UID(s) of the blog owner.
ADMIN_EMAILS=
ADMIN_UIDS=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://finecoding.netlify.app
NEXT_PUBLIC_GA_ID=

# --- Genkit AI (tag suggestions, model: gemini-flash-latest) ---
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- Email notifications (optional) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Address that receives "new subscriber" / "new wishlist request" notifications
ADMIN_EMAIL=

# --- Beehiiv newsletter sync (optional) ---
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
