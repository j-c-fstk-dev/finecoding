rules_version = '2';

// All writes go through the Next.js server (Server Actions using the Firebase
// Admin SDK), which verifies the admin's ID token itself. The Admin SDK and
// service accounts (e.g. the n8n automation) bypass these rules, so browsers
// never need direct write access.
//
// Deploy with: npm run deploy:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Public content: readable by anyone, never writable from the browser.
    match /posts/{postId} {
      allow read: if true;
      allow write: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Private data: no browser access at all.
    match /subscribers/{subscriberId} {
      allow read, write: if false;
    }

    match /wishlist/{wishId} {
      allow read, write: if false;
    }

    // Anything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
